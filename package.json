{
  "name": "dsh-escalation-advisor",
  "version": "0.1.0-alpha.1",
  "description": "Three-mode advisor plugin for DeepSeek Harness: manual second opinion, automatic escalation, and continuous shadow review.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "client", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && node --check client/index.js",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-settings-plugins"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1"
  },
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.2" },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": { "node": "^22.19.0 || >=24.2.0" },
  "keywords": ["dsh-plugin", "deepseek-harness", "advisor", "escalation", "second-opinion", "shadow-reviewer"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/zhangqian98/dsh-escalation-advisor.git" }
}
